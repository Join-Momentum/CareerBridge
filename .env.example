# ── Stripe ────────────────────────────────────────────────────
# Get these from stripe.com → Developers → API Keys
STRIPE_SECRET_KEY=sk_live_...
STRIPE_CTI_PRICE_ID=price_...   # Products → CTI Founding Cohort price ID

# ── Resend ────────────────────────────────────────────────────
# Get this from resend.com → API Keys
RESEND_API_KEY=re_...

# ── Site URL (used for Stripe success/cancel redirects) ───────
SITE_URL=https://yourdomain.com
